@page "/officer/submit/upload"
@layout PortalLayout
@attribute [Authorize(Roles = "OrgOfficer")]
@inject NavigationManager Nav
@inject ApiClient Api
@inject SubmissionWizardState Wizard

<PageTitle>New Submission · Upload</PageTitle>

<div class="page-head">
    <a class="back-btn" href="officer/submit">← Back</a>
    <h1>New Document Submission</h1>
</div>

<SubmissionStepper Current="2" />

<div class="wizard-card">
    <h2>Upload Required Documents</h2>
    <p class="hint">
        @if (Wizard.HasDraft)
        {
            <text>@Wizard.DocumentNumber — Please provide the documents listed in your checklist.</text>
        }
        else
        {
            <text>Please provide the documents listed in your checklist.</text>
        }
    </p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="form-error" role="alert">@_error</p>
    }

    @if (!Wizard.HasDraft)
    {
        <p class="hint">No draft submission found. Start from Select Type.</p>
        <a class="btn btn-primary" href="officer/submit">Go to Select Type</a>
    }
    else if (_loading)
    {
        <p class="hint">Loading upload slots…</p>
    }
    else if (_slots.Count == 0)
    {
        <p class="hint">No attachment requirements for this document type.</p>
        <div class="wizard-actions">
            <button type="button" class="btn btn-primary" @onclick="Continue">Continue →</button>
            <a class="btn btn-ghost" href="officer/submit">Cancel</a>
        </div>
    }
    else
    {
        <div class="upload-grid-fig7">
            @foreach (var slot in _slots)
            {
                var zoneClass = slot.State switch
                {
                    "done" => "ucard-zone done",
                    "uploading" => "ucard-zone uploading",
                    _ => "ucard-zone empty"
                };
                <div class="ucard">
                    <div class="ucard-title">
                        @slot.Requirement.DisplayName
                        @if (slot.IsPrimary)
                        {
                            <span class="ucard-tag">primary</span>
                        }
                        else if (!slot.Requirement.IsMandatory)
                        {
                            <span class="ucard-tag">optional</span>
                        }
                        else if (slot.Requirement.IsConditional)
                        {
                            <span class="ucard-tag">conditional</span>
                        }
                    </div>
                    <div class="@zoneClass">
                        @if (slot.State != "uploading")
                        {
                            <InputFile OnChange="e => OnFileSelected(e, slot)"
                                       accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,application/pdf,image/png,image/jpeg,image/tiff" />
                        }

                        @if (slot.State == "empty")
                        {
                            <p class="ucard-placeholder">Drop images/PDF files or click to browse.</p>
                        }
                        else if (slot.State == "uploading")
                        {
                            <div class="ucard-file">@slot.FileName</div>
                            <div class="ucard-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@slot.Progress">
                                <div class="ucard-progress-bar" style="width:@slot.Progress%"></div>
                            </div>
                            <div class="ucard-progress-label">@slot.Progress%</div>
                        }
                        else
                        {
                            <div class="ucard-file">@slot.FileName</div>
                            <div class="ucard-badge">Uploaded</div>
                            <div class="ucard-replace-hint">Click to replace</div>
                        }
                    </div>
                </div>
            }
        </div>

        <p class="upload-count-hint">
            @ProvidedCount of @RequiredCount documents provided.
            @if (OptionalUploadedCount > 0)
            {
                <text> (+@OptionalUploadedCount optional)</text>
            }
        </p>

        <div class="wizard-actions">
            <button type="button" class="btn btn-primary" disabled="@(!CanContinue)" @onclick="Continue">Continue →</button>
            <a class="btn btn-ghost" href="officer/submit">Cancel</a>
        </div>
    }
</div>

@code {
    private string? _error;
    private bool _loading = true;
    private readonly List<UploadSlot> _slots = [];

    private IEnumerable<UploadSlot> MandatorySlots =>
        _slots.Where(s => s.Requirement.IsMandatory && !s.Requirement.IsConditional);

    private int RequiredCount => MandatorySlots.Count();
    private int ProvidedCount => MandatorySlots.Count(s => s.State == "done");
    private int OptionalUploadedCount =>
        _slots.Count(s => (!s.Requirement.IsMandatory || s.Requirement.IsConditional) && s.State == "done");

    private bool CanContinue =>
        Wizard.HasDraft
        && !_slots.Any(s => s.State == "uploading")
        && MandatorySlots.All(s => s.State == "done");

    protected override async Task OnInitializedAsync()
    {
        if (!Wizard.HasDraft)
        {
            _loading = false;
            return;
        }

        BuildSlotsFromWizard();
        await HydrateFromServerAsync();
        _loading = false;
    }

    private void BuildSlotsFromWizard()
    {
        _slots.Clear();
        var attachments = Wizard.AttachmentRequirements.ToList();
        var primaryKey = Wizard.PrimaryAttachmentRequirement?.RequirementKey;

        foreach (var req in attachments)
        {
            _slots.Add(new UploadSlot
            {
                Requirement = req,
                IsPrimary = req.RequirementKey == primaryKey,
            });
        }
    }

    private async Task HydrateFromServerAsync()
    {
        if (!Wizard.DocumentId.HasValue) return;

        try
        {
            var doc = await Api.GetDocumentAsync(Wizard.DocumentId.Value);
            if (doc is null) return;

            if (!string.IsNullOrWhiteSpace(doc.PrimaryFileName))
            {
                var primary = _slots.FirstOrDefault(s => s.IsPrimary);
                if (primary is not null)
                {
                    primary.State = "done";
                    primary.FileName = doc.PrimaryFileName;
                    primary.Progress = 100;
                }
            }

            foreach (var att in doc.Attachments)
            {
                var slot = _slots.FirstOrDefault(s =>
                    !s.IsPrimary
                    && string.Equals(s.Requirement.RequirementKey, att.AttachmentType, StringComparison.OrdinalIgnoreCase));
                if (slot is null) continue;
                slot.State = "done";
                slot.FileName = att.FileName;
                slot.Progress = 100;
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load existing uploads: {ex.Message}";
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e, UploadSlot slot)
    {
        if (!Wizard.DocumentId.HasValue) return;

        var file = e.File;
        if (file is null) return;

        if (file.Size <= 0)
        {
            _error = "The selected file is empty.";
            return;
        }

        if (file.Size > 50_000_000)
        {
            _error = "File must be 50 MB or smaller.";
            return;
        }

        _error = null;
        slot.State = "uploading";
        slot.FileName = file.Name;
        slot.Progress = 0;
        StateHasChanged();

        try
        {
            var contentType = NormalizeContentType(file.ContentType, file.Name);

            // Buffer locally with read progress (0–35%), then upload with stream progress (35–100%).
            await using var browser = file.OpenReadStream(maxAllowedSize: 50_000_000);
            await using var buffer = new MemoryStream();
            var chunk = new byte[81_920];
            long copied = 0;
            while (true)
            {
                var n = await browser.ReadAsync(chunk);
                if (n == 0) break;
                await buffer.WriteAsync(chunk.AsMemory(0, n));
                copied += n;
                slot.Progress = (int)Math.Clamp(copied * 35.0 / Math.Max(1, file.Size), 0, 35);
                StateHasChanged();
            }

            buffer.Position = 0;
            var progress = new Progress<int>(p =>
            {
                slot.Progress = 35 + (int)(p * 0.65);
                _ = InvokeAsync(StateHasChanged);
            });

            if (slot.IsPrimary)
            {
                await Api.UploadPrimaryFileAsync(
                    Wizard.DocumentId.Value, buffer, file.Name, contentType, progress);
            }
            else
            {
                await Api.UploadAttachmentAsync(
                    Wizard.DocumentId.Value,
                    slot.Requirement.RequirementKey,
                    buffer, file.Name, contentType, progress);
            }

            slot.Progress = 100;
            slot.State = "done";
        }
        catch (Exception ex)
        {
            slot.State = "empty";
            slot.FileName = null;
            slot.Progress = 0;
            _error = ex.Message;
        }
    }

    private void Continue() => Nav.NavigateTo("officer/submit/ocr");

    private static string NormalizeContentType(string? contentType, string fileName)
    {
        var ct = (contentType ?? string.Empty).Trim().ToLowerInvariant();
        if (ct is "application/pdf" or "image/png" or "image/jpeg" or "image/tiff")
            return ct;
        if (ct is "image/jpg") return "image/jpeg";
        if (ct is "image/tif") return "image/tiff";

        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "application/pdf",
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".tif" or ".tiff" => "image/tiff",
            _ => string.IsNullOrWhiteSpace(ct) ? "application/pdf" : ct,
        };
    }

    private sealed class UploadSlot
    {
        public required RequirementDto Requirement { get; init; }
        public bool IsPrimary { get; init; }
        public string State { get; set; } = "empty";
        public string? FileName { get; set; }
        public int Progress { get; set; }
    }
}
